# CapRover nginx TLS'yi açar ve buraya düz HTTP ile gelir; istek Tailscale üzerinden Stalwart'ın 8080'ine gider.
# Stalwart'ta clientIpSource=xForwardedFor, forwardedHops=1: CapRover'ın eklediği en sağdaki adres istemcidir,
# bu yüzden başlık burada değiştirilmeden iletilir. MAIL_HOST CapRover'daki uygulama ortamından gelir.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    client_max_body_size 100m;

    location / {
        proxy_pass http://${MAIL_HOST}:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # JMAP push (WebSocket ve EventSource) uzun süre açık kalır
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
