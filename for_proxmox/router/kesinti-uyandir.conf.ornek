# /opt/etc/kesinti-uyandir.conf (router, Entware). Gerçek değerler yalnız router'da durur.
# UPS'e bağlı olmayan, şebekede sürekli açık iki cihaz (node'lardaki kesinti-izle ile aynı)
HEDEFLER="<mac-1> <mac-2>"
# Uyandırılacak sunucular (küçük harf MAC)
SUNUCULAR="<node-1 mac> <node-2 mac> <node-3 mac>"
# Hedefler en az kaç dakika yoksa kesinti sayılır; dönünce kaç dakika uyandırma denenir
YOK_ESIK=10
PENCERE=30
