#   awk -v genis="${1:-999}" -v dolu="$((8 + ${2:-0} + ${3:-0}))" -v dizin="$((10 + ${4:-0} + ${5:-0}))" -v durum="$durum" -v pil="$pil" -v saat="$(date '+%H:%M · %d %b')" '
#     function renk(y) { return y >= 85 ? "#ff5555" : y >= 60 ? "#f1fa8c" : "#50fa7b" }
#     function yazi(y) { return y >= 85 ? "#ff5555" : y >= 60 ? "#f1fa8c" : "#f8f8f2" }
#     # sivri ayraçlı bölüm: zemin sırayla A/B, ayraç önceki zeminden
#     function bolum(sr, s, yr, d) { z0 = sira++ % 2 ? "#44475a" : "#343746"; out = out sprintf("#[fg=%s,bg=%s]#[fg=%s,bg=%s] %s #[fg=%s]%s ", z0, onceki, sr, z0, s, yr, d); onceki = z0 }
#     function ekle(sr, s, yr, y) { m++; SR[m] = sr; S[m] = s; YR[m] = yr; Y[m] = y }
#     FILENAME == durum { pu = $1; pt = $2; pi = $3; pz = $4; pcpu = $5; next }
#     FILENAME == "/proc/uptime" { z = $1 + 0; next }
#     $1 == "usage_usec" { u = $2; next }
#     # user nice system idle iowait irq softirq steal; guest alanları user içinde sayılmış
#     FILENAME == "/proc/stat" && $1 == "cpu" { for (i = 2; i <= 9; i++) t += $i; idle = $5 + $6; next }
#     FILENAME == "/proc/stat" && $1 ~ /^cpu[0-9]/ { n++; next }
