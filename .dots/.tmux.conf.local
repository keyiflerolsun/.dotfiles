# : << 'EOF'
# Oh my tmux! kişisel ayarları; yalnız varsayılandan farklar. Tam liste:
# https://github.com/gpakosz/.tmux/blob/master/.tmux.conf.local

# -- görünüm ----------------------------------------------------------------------
# Renkler (Dracula): zemin #282a36, yüzey #343746 #44475a, soluk #6272a4, yazı #f8f8f2,
# mor #bd93f9, camgöbeği #8acefb, turuncu #ffb86c, yeşil #50fa7b, pembe #ff79c6, kırmızı #ff5555, sarı #f1fa8c
tmux_conf_24b_colour=auto
tmux_conf_theme=disabled

set -g status-position bottom
set -g status-style "bg=default,fg=#f8f8f2"
set -g status-left-style default
set -g status-right-style default
set -g status-justify left
set -g status-left-length 60
set -g status-right-length 160
set -g window-status-separator ""
set -g window-status-style default
set -g window-status-current-style default
set -g window-status-last-style default
set -g window-status-activity-style default
set -g window-status-bell-style default

# Sol: oturum adı, sivri uçlu (simge prefix'te kırmızı)
set -g status-left "#[fg=#282a36,bg=#{?client_prefix,#ff5555,#50fa7b}]  #[fg=#{?client_prefix,#ff5555,#50fa7b},bg=#343746]#[fg=#f8f8f2,bg=#343746] #S #[fg=#343746,bg=default] "

# Pencereler: solda ad, sağda numara; etkin olan turuncu dolgulu, ötekilerin numarası camgöbeği; zil "!"
set -g window-status-format "#[fg=#343746]#[fg=#6272a4,bg=#343746]#W#{?window_bell_flag,#[fg=#ff5555] !,} #[fg=#8acefb,bg=#44475a] #I#[fg=#44475a,bg=default] "
set -g window-status-current-format "#[fg=#44475a]#[fg=#ffb86c,bg=#44475a,bold]#W#{?window_zoomed_flag, ,} #[fg=#282a36,bg=#ffb86c] #I#[fg=#ffb86c,bg=default,nobold] "

# Sağ: dizin, makine, sonra _sag (sistem bilgisi, saat)
# Dar ekranda kısalır: 80–119 sütunda dizin/makine yok, 80'den darda yalnız onlar. _sag'a sol ve pencerelerin uzunluğu da
# gider: pencereler çoğaldıkça sekmeler daralmaz, sistem bilgisi azalır (W'deki "-----" pencere biçiminin sabit 5 sütunu)
set -g status-right "#{?#{||:#{e|>=:#{client_width},120},#{e|<:#{client_width},80}},#[fg=#343746#,bg=default]#[fg=#ff79c6#,bg=#343746]  #[fg=#f8f8f2]#{b:pane_current_path} #[fg=#44475a#,bg=#343746]#[fg=#bd93f9#,bg=#44475a]  #[fg=#f8f8f2]#H ,}#(cut -c3- ~/.tmux.conf.local | sh -s _sag #{client_width} #{n:session_name} #{n:#{W:#W#I-----#{?window_bell_flag,--,}#{?#{&&:#{window_active},#{window_zoomed_flag}},--,}}} #{n:#{b:pane_current_path}} #{n:host})"

# İleti, seçim, menü, saat, bölme numarası renkleri. Komut satırı (prefix :, ad değiştirme) çubuğun koyu zemininde
# kayboluyordu: mor zemin, koyu yazı
set -g message-style "fg=#282a36,bg=#bd93f9,bold"
set -g message-command-style "fg=#282a36,bg=#ff79c6,bold"
set -g mode-style "fg=#282a36,bg=#f1fa8c"
set -g menu-style "fg=#f8f8f2,bg=#282a36"
set -g menu-selected-style "fg=#282a36,bg=#bd93f9"
set -g menu-border-style "fg=#6272a4"
set -g popup-border-style "fg=#bd93f9"
set -g clock-mode-colour "#8acefb"
set -g display-panes-active-colour "#ffb86c"
set -g display-panes-colour "#8acefb"

# Bölme kenarı: etkin mor, kopyalama kipinde sarı, eşzamanlı yazmada kırmızı
set -g pane-border-style "fg=#44475a"
set -g pane-active-border-style "fg=#{?pane_in_mode,#f1fa8c,#{?synchronize-panes,#ff5555,#bd93f9}}"

# Kopyalanan metin sistem panosuna
tmux_conf_copy_to_os_clipboard=true

# -- genel ------------------------------------------------------------------------

set -g default-shell /bin/zsh
set -g mouse on
# Vim'in ve ssh'taki uygulamaların OSC 52'si sistem panosuna geçsin (varsayılan external onu yok sayar)
set -g set-clipboard on
set -g history-limit 100000

# Açılır pencere ve menü köşeleri yuvarlak
set -g popup-border-lines rounded
set -g menu-border-lines rounded

# Bölme başlığı: numara ve ad; etkin bölme mor
set -g pane-border-status top
set -g pane-border-format "#{?pane_active,#[fg=#bd93f9]\uE0B6#[fg=#282a36]#[bg=#bd93f9]#[bold] #{pane_index}  #{pane_title} #[fg=#bd93f9]#[bg=default]#[nobold]\uE0B4,#[fg=#6272a4] #{pane_index}  #{pane_title} }"

# Arka pencerede zil çalınca sekme işaretlenir
set -g monitor-bell on
set -g bell-action other

# -- kısayollar -------------------------------------------------------------------
# Türkçe Q kısayolları: kopyalama <prefix> Enter, yapıştır <prefix> p,
# böl <prefix> - ve _, büyüt <prefix> z, bölme numarası <prefix> q

# Shift+ok: bölmeyi 5 birim büyüt/küçült (<prefix> sonra, tekrarlanır)
bind -r S-Left  resize-pane -L 5
bind -r S-Right resize-pane -R 5
bind -r S-Up    resize-pane -U 5
bind -r S-Down  resize-pane -D 5

# Tek prefix Ctrl-b: oh-my-tmux'un ikinci prefix'i Ctrl-a kabukta satır başını, Vim'de sayı artırmayı yutuyordu
set -gu prefix2
unbind C-a

# Prefix'siz geçiş: Alt+1, Alt+2, Alt+3
bind -n M-1 select-window -t :1 \; select-pane -t :1.1
bind -n M-2 select-window -t :2 \; select-pane -t :2.1
bind -n M-3 select-window -t :2 \; select-pane -t :2.2

# Ctrl-l: kabukta ekranı ve geçmişi temizler (oh-my-tmux); Vim'de sağ bölmeye geçiştir, geçmiş silinmez
bind -n C-l if -F '#{m/r:^(vim?|nvim|view)$,#{pane_current_command}}' { send-keys C-l } { send-keys C-l ; run 'sleep 0.2' ; clear-history }

# Kopyalama kipi: v seçimi başlatır, y panoya kopyalayıp çıkar
bind -T copy-mode v send-keys -X begin-selection
bind -T copy-mode y send-keys -X copy-pipe-and-cancel

# Bölme taşı <prefix> j (oh-my-tmux'un j'sini, alttaki bölmeye geçişi ezer; ok tuşlarıyla geçiş kalır). Hedef numara
# yazılmaz, bütün oturumlardan önizlemeli ağaçla seçilir; bulunduğun pencere ağaçta gizli, olamayacak iş soluk.
bind j display-menu -T "#[align=centre]Bölme taşı" -x C -y C \
  "Buraya getir, sağa"       h { choose-tree -Zw -f "##{!=:##{window_id},#{window_id}}" { join-pane -h -s "%%" } } \
  "Buraya getir, alta"       v { choose-tree -Zw -f "##{!=:##{window_id},#{window_id}}" { join-pane -v -s "%%" } } \
  "" \
  "Bunu götür, yanına"       H { choose-tree -Zw -f "##{!=:##{window_id},#{window_id}}" { join-pane -h -s "#{pane_id}" -t "%%" } } \
  "Bunu götür, altına"       V { choose-tree -Zw -f "##{!=:##{window_id},#{window_id}}" { join-pane -v -s "#{pane_id}" -t "%%" } } \
  "#{?#{>:#{window_panes},1},,-}Yeni pencereye ayır"  b { break-pane } \
  "" \
  "Yer değiştir"             s { choose-tree -Z { swap-pane -t "%%" } }

# -- eklentiler (tpm) --------------------------------------------------------------
# <prefix> I kur, <prefix> u güncelle, <prefix> M-u kaldır

# Oturum düzeni 15 dk'da bir kaydedilir (<prefix> C-s kaydet, C-r hepsini yükle). Açılışta kendiliğinden yüklenmez: kayıtlı
# oturumlar <prefix> g listesinde, enter yalnız seçileni kurar
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-restore 'off'
# continuum yalnız bağlı istemci durum çubuğunu çizerken kaydeder (status-right'taki #()): ayrılmış sunucuda hiç kayıt olmaz,
# reboot sonrası liste boş kalırdı. Ayrılınca ve oturum/pencere yapısı değişince de kaydedilir; aynı içerikli kayıt resurrect'çe
# silinir. Kapanış kancası (session-closed, window-unlinked) yok: son oturum kapanırken sunucusuz koşan kayıt boş dosya yazardı.
# Sabit indeks [50]: yapılandırma yeniden okununca kanca çoğalmaz
%hidden KAYDET='run-shell -b "test -x ~/.tmux/plugins/tmux-resurrect/scripts/save.sh && ~/.tmux/plugins/tmux-resurrect/scripts/save.sh quiet || true"'
set-hook -g 'client-detached[50]'    "$KAYDET"
set-hook -g 'session-created[50]'    "$KAYDET"
set-hook -g 'session-renamed[50]'    "$KAYDET"
set-hook -g 'after-new-window[50]'   "$KAYDET"
set-hook -g 'after-split-window[50]' "$KAYDET"

# Yüzen bölme: <prefix> a
set -g @plugin 'omerxx/tmux-floax'
set -g @floax-width '60%'
set -g @floax-height '60%'
set -g @floax-bind 'a'
set -g @floax-change-path 'true'
# Çerçeve mor, başlık camgöbeği
set -g @floax-border-color '#bd93f9'
set -g @floax-text-color '#8acefb'

# Oturum seçici: <prefix> g. Yerel makinenin, Tailscale'deki ve @oturum-makineler'deki makinelerin oturumları (github.com/keyiflerolsun/tmux-oturum).
# Enter bağlan, ctrl-f satırın makinesinde dizin seç, ctrl-x kapat, ctrl-r yeniden adlandır; yeni ad + Enter yeni oturum.
set -g @plugin 'keyiflerolsun/tmux-oturum'
set -g @oturum-tus 'g'
set -g @oturum-genislik '90%'
set -g @oturum-yukseklik '75%'
set -g @oturum-fzf "--color=bg:-1,bg+:#343746,fg:#f8f8f2,fg+:#f8f8f2,hl:#ff5555,hl+:#ff5555,info:#bd93f9,prompt:#bd93f9,pointer:#ff79c6,marker:#bd93f9,spinner:#ff79c6,header:#ff5555,border:#6272a4,label:#f8f8f2"

# Ekrandaki bağlantıyı seçip açma: <prefix> v
set -g @plugin 'wfxr/tmux-fzf-url'
set -g @fzf-url-bind 'v'
set -g @fzf-url-history-limit '2000'

# -- oh-my-tmux betik kuyruğu: silme, altına yazma ---------------------------------
# (dosya `cut -c3- | sh` ile betik olarak da okunur; #(… | sh -s _ad) işlevleri EOF ile "$@" arasında)
# EOF
#
# # Sağ şerit: işlemci, bellek, disk (yeşil/sarı/kırmızı: <60, <85), pil (varsa), açık kalma süresi, saat.
# # İşlemci cgroup sayacından (Proxmox CT'de /proc/stat ~2 kat gösteriyordu), yoksa /proc/stat.
# # İki okuma arası farktır; önceki okuma $TMPDIR'de, 2 sn'den kısa aralıkta son değer yinelenir.
