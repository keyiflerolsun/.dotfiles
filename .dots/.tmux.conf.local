#       ram = mt ? 100 * (mt - ma) / mt : 0
#       disk = d[5] + 0
#       gun = int(z / 86400); sa = int(z % 86400 / 3600); dk = int(z % 3600 / 60)
#       acik = gun ? sprintf("%dg %dsa", gun, sa) : sa ? sprintf("%dsa %ddk", sa, dk) : sprintf("%ddk", dk)
#       # 80 sütundan darda şerit yalnız dizin ve makinedir (status-right); 80–119 arası onlarsız, boş zeminden başlar
#       if (genis < 80) exit
#       onceki = genis >= 120 ? "#44475a" : "default"; sira = 0
