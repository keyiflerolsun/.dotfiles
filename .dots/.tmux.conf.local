#     END {
#       if (pz && z - pz >= 2) {
#         cpu = (u && pu) ? (u - pu) / 1e4 / (z - pz) / n : (t > pt ? 100 * (t - pt - (idle - pi)) / (t - pt) : 0)
#         cpu = cpu > 100 ? 100 : cpu
#         printf "%d %d %d %.2f %.1f\n", u, t, idle, z, cpu > durum
#       } else if (pz) cpu = pcpu
#       else printf "%d %d %d %.2f 0\n", u, t, idle, z > durum
